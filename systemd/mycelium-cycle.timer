# mycelium-cycle.timer — runs mycelium-cycle.service every 30 minutes.
#
# Install:
#   cp mycelium-cycle.service mycelium-cycle.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now mycelium-cycle.timer

[Unit]
Description=Run mycelium-cycle every 30 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
